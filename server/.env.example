# Только на сервере. Пустой ключ разрешает health/auth, AI вернёт AI_NOT_CONFIGURED.
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com
HOST=127.0.0.1
PORT=8787
STATE_FILE=.state/auth.json
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PAIR_TTL_SECONDS=300
REQUESTS_PER_MINUTE=6
PAIR_ATTEMPTS_PER_10_MINUTES=10
MAX_CONTEXT_BYTES=65536
MAX_OUTPUT_TOKENS=1800
PROVIDER_TIMEOUT_MS=60000
# 0 или 1; потоковые и невалидные ответы не повторяются автоматически.
PROVIDER_RETRIES=0
# HTTPS завершается в reverse proxy на loopback. Не задавайте true для произвольных прокси.
TRUST_PROXY=127.0.0.1
# true разрешает HTTP только с loopback; для production с HTTPS задайте false.
ALLOW_LOCAL_HTTP=true
