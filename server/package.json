{
  "name": "trenirovki-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "pair": "tsx --env-file-if-exists=.env src/pair.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "fastify": "5.6.2", "zod": "4.1.12" },
  "devDependencies": { "@types/node": "24.10.1", "tsx": "4.20.6", "typescript": "5.9.3" }
}
